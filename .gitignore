.venv/
__pycache__/
.DS_Store
logs/
*.pt
!models/*.pt

# Data: only the test split, stats and a short demo clip are committed (the app uses them);
# the rest is regenerated by scripts/prepare_dataset.py
data/*
!data/yolo/
data/yolo/*
!data/yolo/test/
!data/yolo/stats.json
!data/videos/
data/videos/*
!data/videos/genoa_aquarium_15s.mp4
!data/videos/CREDITS.md

# Training runs: only curves and evaluation plots used by the app
runs/*
!runs/y8s_raw/
runs/y8s_raw/*
!runs/y8s_raw/results.csv
!runs/y8s_raw/results.png
!runs/eval/
runs/eval/*/val_batch*

results/*.mp4
